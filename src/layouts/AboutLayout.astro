---
import type { MarkdownLayoutProps } from "astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Layout from "./Layout.astro";
import { SITE } from "@/config";

type Props = MarkdownLayoutProps<{ title: string }>;

const { frontmatter } = Astro.props;

const featuredProjects = [
  {
    name: "CodeMateX",
    emoji: "🤖",
    tag: "On-Device AI",
    summary:
      "100% offline Android coding tutor powered by LiteRT-LM & Gemma with 600+ interactive lessons.",
    stack: ["LiteRT-LM", "Gemma", "Compose"],
    primaryUrl:
      "https://play.google.com/store/apps/details?id=dev.hossain.codematex",
    primaryLabel: "Google Play",
    secondaryUrl: "https://github.com/hossain-khan/android-code-with-ai",
    secondaryLabel: "GitHub",
  },
  {
    name: "Compose Highlight & Shiki",
    emoji: "🎨",
    tag: "Open Source",
    summary:
      "Native Jetpack Compose syntax highlighting library & edge Shiki token service for Android and iOS.",
    stack: ["Compose", "Highlight.js", "Shiki"],
    primaryUrl: "https://github.com/hossain-khan/android-compose-highlight",
    primaryLabel: "Compose Lib",
    secondaryUrl: "https://github.com/hossain-khan/shiki-token-service",
    secondaryLabel: "Shiki Service",
  },
  {
    name: "TRMNL Ecosystem",
    emoji: "📟",
    tag: "E-Ink & Plugins",
    summary:
      "Android Buddy companion app, display mirror, and custom e-ink plugins (Elements, Quotes, Pickup).",
    stack: ["Kotlin", "TRMNL", "Liquid"],
    primaryUrl:
      "https://play.google.com/store/apps/details?id=ink.trmnl.android.buddy",
    primaryLabel: "Google Play",
    secondaryUrl: "https://github.com/hossain-khan/trmnl-android-buddy",
    secondaryLabel: "GitHub",
  },
  {
    name: "Snippet & Vibe Artifacts",
    emoji: "⚡",
    tag: "Rapid Prototyping",
    summary:
      "Offline code notebook for Android, Edge Code Playground on Cloudflare Workers, JSON5-Kotlin, and more.",
    stack: ["Android", "Workers", "Kotlin"],
    primaryUrl:
      "https://play.google.com/store/apps/details?id=dev.hossain.codesnippet",
    primaryLabel: "Snippet App",
    secondaryUrl: "https://hossainkhan.com/#vibe-artifacts",
    secondaryLabel: "20+ Artifacts",
  },
];

const androidStack = [
  "Kotlin",
  "Jetpack Compose",
  "Circuit (MVI)",
  "MVVM",
  "Metro / Dagger",
  "Coroutines & Flow",
  "SQLDelight",
  "Material 3",
];

const aiToolkit = [
  "Claude Code",
  "GitHub Copilot",
  "Cursor",
  "Gemini CLI",
  "LiteRT-LM",
  "Cloudflare Workers",
  "OpenAPI",
  "GitHub Actions",
];
---

<Layout title={`${frontmatter.title} | ${SITE.title}`}>
  <Header />
  <Breadcrumb />
  <main id="main-content" class="app-layout">
    <!-- Hero with interactive aurora -->
    <div class="about-hero" data-about-hero>
      <div class="aurora-orb aurora-orb-1"></div>
      <div class="aurora-orb aurora-orb-2"></div>
      <div class="aurora-orb aurora-orb-3"></div>
      <div class="aurora-mouse" data-about-mouse></div>
      <div class="hero-content">
        <div class="avatar-ring">
          <div class="avatar-glow"></div>
          <div class="avatar-inner">
            <span class="avatar-emoji">👨🏽‍💻</span>
          </div>
        </div>
        <h1 class="hero-title">
          <span class="greeting">Hello, I'm</span>
          <span class="name-glow">{SITE.author}</span>
        </h1>
        <p class="hero-meta">
          📍 Toronto, Canada <span class="meta-dot">·</span> Senior Software
          Engineer @ <strong>Slack</strong>
        </p>
        <div class="hero-badges">
          <span class="badge" data-badge>
            🚀 Engineer
          </span>
          <span class="badge" data-badge>
            🧪 Vibe Coder
          </span>
          <span class="badge" data-badge>
            🍔 Foodie
          </span>
          <span class="badge" data-badge>
            📸 Photographer
          </span>
        </div>
      </div>
    </div>

    <!-- Brief Bio Intro (from about.md) -->
    <section
      id="about"
      class="about-intro app-prose mb-8 max-w-app prose-img:border-0"
    >
      <slot />
    </section>

    <!-- Visual Bento Grid -->
    <div class="bento-grid mb-24" data-bento-grid>
      <!-- Bento Card 1: Featured Builds & Vibe-Coded Projects (Full Width) -->
      <article class="bento-card bento-span-full" data-bento-card>
        <header class="bento-header">
          <div class="bento-title-group">
            <span class="bento-eyebrow">Shipped & Vibe-Coded</span>
            <h2 class="bento-heading">Featured Builds</h2>
          </div>
          <a
            href="https://hossainkhan.com/#latest-projects"
            target="_blank"
            rel="noopener noreferrer"
            class="bento-header-link"
          >
            Full portfolio <span class="sr-only">on hossainkhan.com</span> ↗
          </a>
        </header>

        <div class="projects-grid">
          {featuredProjects.map(project => (
            <article class="project-mini-card">
              <header class="project-mini-header">
                <h3 class="project-mini-title">
                  <span aria-hidden="true">{project.emoji}</span> {project.name}
                </h3>
                <span class="project-mini-tag">{project.tag}</span>
              </header>
              <p class="project-mini-summary">{project.summary}</p>
              <footer class="project-mini-footer">
                <ul class="project-mini-stack" aria-label="Technologies">
                  {project.stack.map(tech => (
                    <li>{tech}</li>
                  ))}
                </ul>
                <div class="project-mini-links">
                  <a
                    href={project.primaryUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {project.primaryLabel}
                    <span class="sr-only"> for {project.name}</span> ↗
                  </a>
                  <a
                    href={project.secondaryUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    {project.secondaryLabel}
                    <span class="sr-only"> for {project.name}</span> ↗
                  </a>
                </div>
              </footer>
            </article>
          ))}
        </div>
      </article>

      <!-- Bento Card 2: Core Stack & AI Toolkit -->
      <article class="bento-card" data-bento-card>
        <header class="bento-header">
          <div class="bento-title-group">
            <span class="bento-eyebrow">Daily Drivers</span>
            <h2 class="bento-heading">Stack & AI Toolkit</h2>
          </div>
        </header>

        <div class="stack-groups">
          <div>
            <h3 class="stack-group-label">Android & Architecture</h3>
            <ul class="pill-list">
              {androidStack.map(item => (
                <li class="pill pill-accent">{item}</li>
              ))}
            </ul>
          </div>
          <div>
            <h3 class="stack-group-label">AI Workflow & Edge</h3>
            <ul class="pill-list">
              {aiToolkit.map(item => (
                <li class="pill">{item}</li>
              ))}
            </ul>
          </div>
        </div>
      </article>

      <!-- Bento Card 3: Beyond Code / Off the Clock -->
      <article class="bento-card" data-bento-card>
        <header class="bento-header">
          <div class="bento-title-group">
            <span class="bento-eyebrow">Off the Clock</span>
            <h2 class="bento-heading">Beyond the Terminal</h2>
          </div>
        </header>

        <dl class="facts-list">
          <div class="fact-row">
            <dt>🎧 Coding Fuel</dt>
            <dd>
              Ambient sessions — <em>Enigma</em>, <em>Eguana</em>,{" "}
              <em>Yanni</em> &amp;{" "}
              <a
                href="https://www.youtube.com/watch?v=as9BCiK16d0"
                target="_blank"
                rel="noopener noreferrer"
              >
                Max Payne themes
              </a>
            </dd>
          </div>
          <div class="fact-row">
            <dt>📸 Through the Lens</dt>
            <dd>
              Capturing moments at{" "}
              <a
                href="https://vision.hossainkhan.com/"
                target="_blank"
                rel="noopener noreferrer"
              >
                vision.hossainkhan.com
              </a>{" "}
              (with a live{" "}
              <a
                href="https://play.google.com/store/apps/details?id=com.hossainkhan.vision"
                target="_blank"
                rel="noopener noreferrer"
              >
                Muzei wallpaper app
              </a>
              )
            </dd>
          </div>
          <div class="fact-row">
            <dt>🗺️ AFK Mode</dt>
            <dd>
              Scenic road trips, world travel, video games, and hunting down
              great food spots.
            </dd>
          </div>
          <div class="fact-row">
            <dt>🎓 Roots</dt>
            <dd>BSc in Computer Science, University of Windsor</dd>
          </div>
        </dl>
      </article>

      <!-- Bento Card 4: Compact Connect Strip (Full Width) -->
      <article class="bento-card bento-span-full bento-connect" data-bento-card>
        <div class="connect-copy">
          <h2 class="connect-heading">Let's Connect</h2>
          <p class="connect-quote">
            "15+ years of crafting code, one feature at a time."
          </p>
        </div>
        <footer class="connect-actions">
          <a
            href="https://hossainkhan.com"
            target="_blank"
            rel="noopener noreferrer"
            class="connect-btn connect-btn-primary"
          >
            Portfolio ↗
          </a>
          <a
            href="https://github.com/hossain-khan"
            target="_blank"
            rel="noopener noreferrer"
            class="connect-btn"
          >
            GitHub ↗
          </a>
          <a href="mailto:blog@hossain.dev" class="connect-btn">
            blog@hossain.dev
          </a>
        </footer>
      </article>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  let aboutCleanup: AbortController | null = null;

  document.addEventListener("astro:page-load", () => {
    if (aboutCleanup) aboutCleanup.abort();
    aboutCleanup = new AbortController();
    const { signal } = aboutCleanup;

    const hero = document.querySelector("[data-about-hero]") as HTMLElement;
    const mouseOrb = document.querySelector(
      "[data-about-mouse]"
    ) as HTMLElement;

    if (hero && mouseOrb) {
      hero.addEventListener(
        "mousemove",
        e => {
          requestAnimationFrame(() => {
            const rect = hero.getBoundingClientRect();
            const x = e.clientX - rect.left;
            const y = e.clientY - rect.top;
            mouseOrb.style.setProperty("--mx", `${x}px`);
            mouseOrb.style.setProperty("--my", `${y}px`);
            mouseOrb.style.opacity = "1";
          });
        },
        { signal }
      );

      hero.addEventListener(
        "mouseleave",
        () => {
          mouseOrb.style.opacity = "0";
        },
        { signal }
      );
    }

    // Badge & Bento Card hover glow
    const interactiveEls = document.querySelectorAll(
      "[data-badge], [data-bento-card]"
    );
    interactiveEls.forEach(el => {
      el.addEventListener(
        "mousemove",
        e => {
          requestAnimationFrame(() => {
            const rect = (el as HTMLElement).getBoundingClientRect();
            const x = (e as MouseEvent).clientX - rect.left;
            const y = (e as MouseEvent).clientY - rect.top;
            (el as HTMLElement).style.setProperty("--bx", `${x}px`);
            (el as HTMLElement).style.setProperty("--by", `${y}px`);
          });
        },
        { signal }
      );
    });
  });
</script>

<style>
  .about-hero {
    position: relative;
    overflow: hidden;
    border-radius: 1.5rem;
    padding: 2.5rem 1.75rem;
    margin-bottom: 2rem;
    background: color-mix(
      in srgb,
      var(--color-foreground) 3%,
      var(--color-background)
    );
    border: 1px solid color-mix(in srgb, var(--color-accent) 12%, transparent);
  }

  /* Floating aurora orbs */
  .aurora-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(60px);
    pointer-events: none;
    will-change: transform;
  }

  .aurora-orb-1 {
    width: 350px;
    height: 350px;
    top: -40%;
    left: -15%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-accent) 25%, transparent),
      transparent 70%
    );
    animation: orb-1 7s ease-in-out infinite alternate;
  }

  .aurora-orb-2 {
    width: 280px;
    height: 280px;
    top: 0%;
    right: -10%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-border) 22%, transparent),
      transparent 70%
    );
    animation: orb-2 9s ease-in-out infinite alternate;
  }

  .aurora-orb-3 {
    width: 220px;
    height: 220px;
    bottom: -25%;
    left: 35%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-accent) 15%, transparent),
      transparent 70%
    );
    animation: orb-3 11s ease-in-out infinite alternate;
  }

  @keyframes orb-1 {
    0% {
      transform: translate(0, 0) scale(1);
    }
    100% {
      transform: translate(50px, 30px) scale(1.25);
    }
  }
  @keyframes orb-2 {
    0% {
      transform: translate(0, 0) scale(1);
    }
    100% {
      transform: translate(-40px, 35px) scale(1.2);
    }
  }
  @keyframes orb-3 {
    0% {
      transform: translate(0, 0) scale(1);
    }
    100% {
      transform: translate(25px, -30px) scale(1.15);
    }
  }

  /* Mouse-follow aurora */
  .aurora-mouse {
    position: absolute;
    width: 400px;
    height: 400px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-accent) 20%, transparent),
      color-mix(in srgb, var(--color-border) 10%, transparent) 35%,
      transparent 70%
    );
    filter: blur(50px);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s ease;
    transform: translate(
      calc(var(--mx, 0px) - 200px),
      calc(var(--my, 0px) - 200px)
    );
    will-change: transform;
    z-index: 1;
  }

  .hero-content {
    position: relative;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1rem;
  }

  /* Avatar */
  .avatar-ring {
    position: relative;
    width: 96px;
    height: 96px;
    border-radius: 50%;
    padding: 3px;
    background: conic-gradient(
      from 0deg,
      var(--color-accent),
      var(--color-border),
      var(--color-accent),
      var(--color-border),
      var(--color-accent)
    );
    animation: ring-spin 6s linear infinite;
  }

  @keyframes ring-spin {
    0% {
      transform: rotate(0deg);
    }
    100% {
      transform: rotate(360deg);
    }
  }

  .avatar-glow {
    position: absolute;
    inset: -12px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-accent) 30%, transparent),
      transparent 70%
    );
    animation: pulse-glow 3s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes pulse-glow {
    0%,
    100% {
      opacity: 0.3;
      transform: scale(1);
    }
    50% {
      opacity: 0.7;
      transform: scale(1.15);
    }
  }

  .avatar-inner {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: var(--color-background);
    display: flex;
    align-items: center;
    justify-content: center;
    animation: ring-spin 6s linear infinite reverse;
  }

  .avatar-emoji {
    font-size: 2.5rem;
    line-height: 1;
  }

  .hero-title {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .greeting {
    font-size: 0.95rem;
    font-weight: 400;
    color: var(--color-foreground);
    opacity: 0.7;
  }

  .name-glow {
    font-size: clamp(1.85rem, 1.35rem + 2vw, 2.5rem);
    font-weight: 800;
    background: linear-gradient(
      135deg,
      var(--color-foreground) 30%,
      var(--color-accent)
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    filter: drop-shadow(
      0 0 25px color-mix(in srgb, var(--color-accent) 30%, transparent)
    );
  }

  .hero-meta {
    font-size: 0.9rem;
    color: var(--color-foreground);
    opacity: 0.8;
    margin: -0.25rem 0 0;
  }

  .hero-meta strong {
    color: var(--color-accent);
    font-weight: 700;
  }

  .meta-dot {
    margin: 0 0.35rem;
    opacity: 0.5;
  }

  /* Badges with mouse-reactive glow */
  .hero-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }

  .badge {
    position: relative;
    overflow: hidden;
    padding: 0.4rem 1rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-foreground);
    background: color-mix(
      in srgb,
      var(--color-foreground) 4%,
      var(--color-background)
    );
    border: 1px solid color-mix(in srgb, var(--color-accent) 15%, transparent);
    backdrop-filter: blur(12px);
    transition:
      transform 0.3s ease,
      border-color 0.3s ease,
      box-shadow 0.3s ease;
    cursor: default;
  }

  .badge::before {
    content: "";
    position: absolute;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-accent) 35%, transparent),
      transparent 70%
    );
    filter: blur(15px);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
    transform: translate(
      calc(var(--bx, 50%) - 40px),
      calc(var(--by, 50%) - 40px)
    );
  }

  .badge:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--color-accent) 35%, transparent);
    box-shadow:
      0 6px 20px color-mix(in srgb, var(--color-accent) 15%, transparent),
      inset 0 1px 0 color-mix(in srgb, var(--color-accent) 8%, transparent);
  }

  .badge:hover::before {
    opacity: 1;
  }

  /* Intro prose */
  .about-intro :global(p) {
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
    line-height: 1.75;
    margin: 0;
    opacity: 0.9;
  }

  /* ── Bento Grid ── */
  .bento-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  @media (min-width: 768px) {
    .bento-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .bento-span-full {
      grid-column: 1 / -1;
    }
  }

  .bento-card {
    container-type: inline-size;
    position: relative;
    overflow: hidden;
    border-radius: 1.25rem;
    padding: 1.5rem;
    background: color-mix(
      in srgb,
      var(--color-foreground) 2.5%,
      var(--color-background)
    );
    border: 1px solid color-mix(in srgb, var(--color-border) 28%, transparent);
    transition:
      border-color 0.3s ease,
      box-shadow 0.3s ease;
  }

  .bento-card::before {
    content: "";
    position: absolute;
    width: 260px;
    height: 260px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      color-mix(in srgb, var(--color-accent) 14%, transparent),
      transparent 70%
    );
    filter: blur(28px);
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.35s ease;
    transform: translate(
      calc(var(--bx, 50%) - 130px),
      calc(var(--by, 50%) - 130px)
    );
    z-index: 0;
  }

  .bento-card:hover {
    border-color: color-mix(in srgb, var(--color-accent) 35%, transparent);
    box-shadow: 0 12px 32px -12px
      color-mix(in srgb, var(--color-accent) 14%, transparent);
  }

  .bento-card:hover::before {
    opacity: 1;
  }

  .bento-card > * {
    position: relative;
    z-index: 1;
  }

  .bento-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.15rem;
  }

  .bento-title-group {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .bento-eyebrow {
    font-family: var(--font-cartograph);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-accent);
    opacity: 0.85;
  }

  .bento-heading {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0;
    color: var(--color-foreground);
  }

  .bento-header-link {
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }

  .bento-header-link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  /* Projects Mini Grid inside Bento Card 1 (container-query driven) */
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.9rem;
  }

  @container (min-width: 560px) {
    .projects-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .project-mini-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 0.65rem;
    padding: 1.05rem;
    border-radius: 0.9rem;
    background: color-mix(in srgb, var(--color-background) 70%, transparent);
    border: 1px solid color-mix(in srgb, var(--color-border) 22%, transparent);
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }

  .project-mini-card:hover {
    border-color: color-mix(in srgb, var(--color-accent) 40%, transparent);
    transform: translateY(-2px);
  }

  .project-mini-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
  }

  .project-mini-title {
    font-size: 0.98rem;
    font-weight: 700;
    margin: 0;
    color: var(--color-foreground);
  }

  .project-mini-tag {
    font-family: var(--font-cartograph);
    font-size: 0.68rem;
