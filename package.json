    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.3.7",
    "dayjs": "^1.11.20",
    "dompurify": "^3.4.5",
    "lodash.kebabcase": "^4.1.1",
    "marked": "^18.0.4",
    "remark-collapse": "^0.1.2",
    "remark-github-alerts": "^0.1.1",
    "remark-toc": "^9.0.0",
