{
  "name": "hossains-dev-bytes",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "wrangler types && astro check && node --import tsx scripts/publishToAtmosphere.ts && astro build && pagefind --site dist/client && cp -r dist/client/pagefind public/",
    "sync:atmosphere": "node --import tsx scripts/publishToAtmosphere.ts",
    "preview": "astro preview",
    "sync": "astro sync",
    "astro": "astro",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "generate-types": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.0",
    "@astrojs/markdown-remark": "^7.3.3",
    "@astrojs/mdx": "^8.1.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@mastrojs/atproto": "jsr:^0.2.5",
    "@mastrojs/markdown": "jsr:^0.2.2",
    "@resvg/resvg-wasm": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.0",
    "dayjs": "^1.11.23",
    "dompurify": "^3.4.17",
    "lodash.kebabcase": "^4.1.1",
    "marked": "^18.1.1",
    "remark-collapse": "^0.1.2",
    "remark-github-alerts": "^0.1.1",
    "remark-toc": "^9.0.0",
    "satori": "^0.62.0",
    "sharp": "^0.35.5",
    "slugify": "^1.6.9",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@pagefind/default-ui": "^1.5.2",
    "@shikijs/transformers": "^4.5.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/lodash.kebabcase": "^4.1.9",
    "@types/node": "^26.6.5",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.13.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
